APP_NAME=Chatbot Layanan Akademik
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=9000
APP_DEBUG=true

# Pisahkan dengan koma jika lebih dari satu origin.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Kompatibilitas awal dengan arsitektur tugas akhir:
# 1) database akademik/sekolah
# 2) database internal chatbot
ACADEMIC_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/academic_school
CHATBOT_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/academic_chatbot

# Jangan aktifkan promosi model otomatis.
AUTO_RETRAIN_ENABLED=false

# Pesan chatbot dihapus isinya setelah jumlah hari berikut.
CHAT_MESSAGE_RETENTION_DAYS=30

# APScheduler
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Jakarta

CHATBOT_MAINTENANCE_HOUR=2
CHATBOT_MAINTENANCE_MINUTE=0
CHATBOT_MAINTENANCE_BATCH_SIZE=500